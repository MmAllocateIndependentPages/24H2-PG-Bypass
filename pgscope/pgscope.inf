;
; pgscope.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = pgscope.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
pgscope.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%pgscope.DeviceDesc% = pgscope_Device, Root\pgscope ; TODO: edit hw-id

[pgscope_Device.NT]
CopyFiles = File_Copy

[File_Copy]
pgscope.sys

;-------------- Service installation
[pgscope_Device.NT.Services]
AddService = pgscope,%SPSVCINST_ASSOCSERVICE%, pgscope_Service_Inst

; -------------- pgscope driver install sections
[pgscope_Service_Inst]
DisplayName    = %pgscope.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\pgscope.sys

[pgscope_Device.NT.Wdf]
KmdfService = pgscope, pgscope_wdfsect

[pgscope_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "pgscope Installation Disk"
pgscope.DeviceDesc = "pgscope Device"
pgscope.SVCDESC = "pgscope Service"
